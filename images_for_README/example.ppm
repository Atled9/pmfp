000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 255 255 255 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 000 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 162 214 126 